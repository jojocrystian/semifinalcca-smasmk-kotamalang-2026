# ==============================================================
# ENVIRONMENT VARIABLES CCA MALANG 2026
# ==============================================================
# Di Vercel, variabel ini akan TERISI OTOMATIS saat Anda klik
# "Create Database" -> "Upstash Redis" di tab Storage Vercel.
# ==============================================================

# Vercel KV / Upstash Redis REST Credentials (Otomatis dari Vercel Storage)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Atau jika menggunakan Upstash Redis langsung
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Room Code Pertandingan (Opsional, Default: CCA-MALANG-2026)
NEXT_PUBLIC_DEFAULT_ROOM_CODE="CCA-MALANG-2026"
